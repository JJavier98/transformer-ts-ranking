# ---------------------------------------------------------------------------
# Weights & Biases — copy this file to .env and fill in your values.
# .env is git-ignored; never commit your actual API key.
# ---------------------------------------------------------------------------

# Required: your personal or service-account API key.
# Obtain it at https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: your W&B entity (username or team name).
# If unset, wandb uses the entity tied to your API key.
WANDB_ENTITY=

# Project name in W&B where all runs are grouped.
WANDB_PROJECT=transformer-ts-ranking

# Set to "disabled" to run without uploading (e.g. in CI or offline machines).
# Options: online | offline | disabled
# WANDB_MODE=online
